{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clango-example-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "../../packages/admin-ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every Worker-owned route is listed explicitly. Anything not listed falls through to the SPA,
    // so a forgotten route shows the admin shell rather than a silent 404 — which is why this is a
    // positive list instead of a catch-all with exclusions.
    "run_worker_first": ["/", "/health", "/stats", "/api/*", "/admin/api/*"],
  },
  "kv_namespaces": [{ "binding": "CACHE", "id": "clango-blog-cache" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "clango-blog-files" }],
  "queues": {
    "producers": [{ "binding": "TASKS", "queue": "clango-blog-tasks" }],
    "consumers": [
      {
        "queue": "clango-blog-tasks",
        "max_batch_size": 10,
        "max_retries": 3,
        // The framework's default: retries are bounded and failures end up here rather than
        // disappearing.
        "dead_letter_queue": "clango-blog-tasks-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB_MAIN",
      "database_name": "clango-blog",
      // Placeholder UUID. Run `wrangler d1 create clango-blog` and paste the real id before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/DB_MAIN",
    },
    {
      // A tenant database. Bindings are static, so each tenant's databases are declared here; this
      // is the ceiling that makes the binding-pool approach the practical one (D-055).
      "binding": "DB_MAIN_ACME",
      "database_name": "clango-blog-acme",
      "database_id": "00000000-0000-0000-0000-000000000010",
      "migrations_dir": "migrations/DB_MAIN",
    },
  ],
}
