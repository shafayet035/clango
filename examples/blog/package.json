{
  "name": "@clango/example-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clango/admin-ui build && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "pnpm --filter @clango/admin-ui build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:makemigrations": "clango makemigrations",
    "db:migrate:local": "clango migrate --local",
    "db:migrate:remote": "clango migrate --remote",
    "build:admin": "pnpm --filter @clango/admin-ui build"
  },
  "dependencies": {
    "@clango/api": "workspace:*",
    "@clango/auth": "workspace:*",
    "@clango/cache": "workspace:*",
    "@clango/core": "workspace:*",
    "@clango/files": "workspace:*",
    "@clango/orm": "workspace:*",
    "@clango/tasks": "workspace:*",
    "@cloudflare/puppeteer": "^1.4.0",
    "hono": "^4.9.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clango/admin-api": "workspace:*",
    "@clango/admin-ui": "workspace:*",
    "@clango/auth-better-auth": "workspace:*",
    "@clango/cli": "workspace:*",
    "@clango/migrate": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.2.2",
    "drizzle-orm": "^0.45.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  }
}
