{
  "name": "@clango/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "clango": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clango/core": "workspace:*",
    "@clango/migrate": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.2",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  }
}
