{
  "name": "@clango/auth",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@clango/core": "workspace:^",
    "@clango/orm": "workspace:^",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@clango/migrate": "workspace:^",
    "@cloudflare/vitest-plugin": "^1.2.2",
    "@cloudflare/workers-types": "^5.20260922.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  },
  "description": "The auth adapter contract, the permission engine and the staff gate.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shafayet035/clango.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false
}
