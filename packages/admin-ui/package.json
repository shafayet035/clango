{
  "name": "@clango/admin-ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clango/core": "workspace:^",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tanstack/react-query": "^5.103.2",
    "lucide-react": "^1.47.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  },
  "exports": {
    ".": "./src/lib/index.ts"
  },
  "files": [
    "lib",
    "dist",
    "src"
  ],
  "description": "The generic admin SPA, built with React and HeroUI.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shafayet035/clango.git",
    "directory": "packages/admin-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
